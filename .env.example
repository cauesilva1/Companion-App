# --- Supabase (embutido nos clients — usuários só fazem login email/senha) ---
# Dashboard → Settings → API. Depois: node scripts/sync-supabase-config.mjs
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="eyJ..."

# --- Ops (nunca commit values reais) ---
# Account access token for CLI deploy: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN="sbp_..."
# Optional: protect tick-decay Edge Function
# CRON_SECRET="..."

# --- Contexto externo (life modes / Xbox) ---
# OpenXBL API key: https://xbl.io — usado em companion-state + context-ingest (modo indoor)
# OPENXBL_API_KEY=""
# Gamertag fica no Companion.xboxGamertag (Settings iOS)
# --- Spotify (um Client ID do produto; usuários só tocam Conectar Spotify) ---
# developer.spotify.com → app → Client ID
# Redirect URI obrigatória: companion://spotify-callback
# Em Development Mode: adicione emails dos testadores no dashboard (até ~25).
# Para qualquer usuário Spotify: peça Extended Quota Mode / revisão.
SPOTIFY_CLIENT_ID=""

# Prisma (migrations / opcional Express local com DB)
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Express local (mock se DATABASE_URL vazio). Não é necessário para sync iPhone↔PC.
# JWT_SECRET="legacy-only"
APP_URL="http://localhost:3333"
PORT=3333

# --- LLM (desktop API local / iOS Keychain) ---
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="openrouter/auto"
NVIDIA_API_KEY="nvapi-..."
NVIDIA_MODEL="deepseek-ai/deepseek-v4-pro-0813"
HUGGINGFACE_API_KEY="hf_..."
HF_MODEL="HuggingFaceH4/zephyr-7b-beta"
