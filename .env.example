# Supabase/Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- LLM: OpenRouter (primário) ---
# Crie sua chave em https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="openrouter/auto"
APP_URL="http://localhost:3333"

# --- LLM: NVIDIA NIM (lista em ordem; se um falhar, tenta o próximo) ---
# Crie sua chave em https://build.nvidia.com (botão "Get API Key")
NVIDIA_API_KEY="nvapi-..."
NVIDIA_MODEL="deepseek-ai/deepseek-v4-pro-0813"
NVIDIA_MODELS="deepseek-ai/deepseek-v4-pro-0813,nvidia/nemotron-3-super-120b-a12b,moonshotai/kimi-k3,openai/gpt-oss-20b"

# --- LLM: Hugging Face (terceiro fallback) ---
# Crie sua chave em https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_..."
HF_MODEL="HuggingFaceH4/zephyr-7b-beta"

PORT=3333
