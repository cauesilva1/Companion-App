generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Mood {
  EXCITED
  HAPPY
  CONTENT
  BORED
  SLEEPY
  SAD
  LONELY
}

enum InteractionType {
  POKE
  FEED
  CHAT
  PLAY
  TEASE
  IGNORE_CHECK
}

enum MissionKind {
  POKE_COUNT
  FEED_COUNT
  PLAY_COUNT
  CHAT_COUNT
  TEASE_COUNT
  OPEN_APP
}

/// Desk / physical presence for IoT + expedition freeze.
enum PresenceStatus {
  present
  away
  expedition
}

/// Auth local (Express) — desktop fallback quando não usa só Supabase.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Mirror of auth.users for display (optional).
model Profile {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
}

/// userId = auth.uid()::text (Supabase Auth). Sem FK Prisma → auth.users.
model Companion {
  id                String         @id @default(cuid())
  userId            String
  name              String
  personality       String
  skin              String         @default("dino-mort")
  /// baby | teen | adult — visual growth; missing stage art falls back to base/
  growthStage       String         @default("baby")
  /// When the companion entered the current growthStage (dwell clock).
  growthStageAt     DateTime       @default(now())
  artStyle          String         @default("pixel")
  backdrop          String         @default("sky")
  archetype         String         @default("curioso")
  mood              Mood           @default(CONTENT)
  energy            Int            @default(80)
  affection         Int            @default(55)
  lastDecayAt       DateTime       @default(now())
  lastInteractionAt DateTime       @default(now())
  presenceStatus    PresenceStatus @default(present)
  lastPresenceAt    DateTime       @default(now())
  presenceRssi      Int?
  /// true when away/expedition — survival tick skips this companion.
  decayFrozen       Boolean        @default(false)
  pendingAlert      String?
  memoryNotes       String[]       @default([])
  /// Quiz preferences: vibe, archetype, focus, communicationStyle, …
  traits            Json?
  createdAt         DateTime       @default(now())
  interactions      Interaction[]

  @@index([userId])
  @@index([decayFrozen])
}

model Interaction {
  id             String          @id @default(cuid())
  companionId    String
  companion      Companion       @relation(fields: [companionId], references: [id], onDelete: Cascade)
  type           InteractionType
  userMessage    String?
  reactionText   String
  moodAfter      Mood
  energyAfter    Int
  affectionAfter Int
  createdAt      DateTime        @default(now())

  @@index([companionId, createdAt])
}

model UserMissionProgress {
  id              String      @id @default(cuid())
  userId          String
  dayKey          String
  kind            MissionKind
  title           String
  description     String
  target          Int
  progress        Int         @default(0)
  rewardEnergy    Int         @default(8)
  rewardAffection Int         @default(5)
  claimed         Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@unique([userId, dayKey, kind])
  @@index([userId, dayKey])
}

model IotDevice {
  id            String    @id @default(cuid())
  userId        String
  deviceKeyHash String
  label         String    @default("mesa")
  lastSeenAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  presenceEvents IotPresenceEvent[]
  interactEvents IotInteractEvent[]

  @@index([userId])
  @@index([deviceKeyHash])
}

model IotPresenceEvent {
  id        String    @id @default(cuid())
  deviceId  String
  device    IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  rssi      Int
  createdAt DateTime  @default(now())

  @@index([deviceId, createdAt])
}

model IotInteractEvent {
  id        String    @id @default(cuid())
  deviceId  String
  device    IotDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime  @default(now())

  @@index([deviceId, createdAt])
}

/// Daily HealthKit step ledger (cloud-authoritative feed).
model StepsLedger {
  id           String   @id @default(cuid())
  userId       String
  dayKey       String
  steps        Int      @default(0)
  energyGranted Int     @default(0)
  updatedAt    DateTime @default(now())

  @@unique([userId, dayKey])
  @@index([userId])
}
