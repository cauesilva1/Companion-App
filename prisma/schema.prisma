generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Mood {
  EXCITED
  HAPPY
  CONTENT
  BORED
  SLEEPY
  SAD
  LONELY
}

enum InteractionType {
  POKE
  FEED
  CHAT
  PLAY
  TEASE
  IGNORE_CHECK
}

enum MissionKind {
  POKE_COUNT
  FEED_COUNT
  PLAY_COUNT
  CHAT_COUNT
  TEASE_COUNT
  OPEN_APP
}

/// Desk / physical presence — legado semântico; agora espelha LifeMode (iOS context).
/// present = indoor | away = work | expedition = sleep
enum PresenceStatus {
  present
  away
  expedition
}

/// Behavioral life context (LLM + decay hibernation). Orthogonal to IoT PresenceStatus.
enum LifeMode {
  work
  indoor
  sleep
}

/// Auth local (Express) — desktop fallback quando não usa só Supabase.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Mirror of auth.users for display (optional).
model Profile {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())
}

/// userId = auth.uid()::text (Supabase Auth). Sem FK Prisma → auth.users.
model Companion {
  id                String         @id @default(cuid())
  userId            String
  name              String
  personality       String
  skin              String         @default("dino-mort")
  /// baby | teen | adult — visual growth; missing stage art falls back to base/
  growthStage       String         @default("baby")
  /// When the companion entered the current growthStage (dwell clock).
  growthStageAt     DateTime       @default(now())
  artStyle          String         @default("pixel")
  backdrop          String         @default("sky")
  archetype         String         @default("curioso")
  mood              Mood           @default(CONTENT)
  energy            Int            @default(80)
  affection         Int            @default(55)
  lastDecayAt       DateTime       @default(now())
  lastInteractionAt DateTime       @default(now())
  presenceStatus    PresenceStatus @default(present)
  lastPresenceAt    DateTime       @default(now())
  /// true only in lifeMode sleep — survival tick skips this companion.
  decayFrozen       Boolean        @default(false)
  /// work | indoor | sleep — computed from phone telemetry (Wi‑Fi, steps, charge, hour).
  lifeMode          LifeMode       @default(indoor)
  lifeModeAt        DateTime       @default(now())
  /// SSID da rede residencial (Sofá/TV) — comparado no ingest.
  homeWifiSsid      String?
  xboxGamertag      String?
  /// Ex.: "online · Forza Horizon 5" (só relevante em indoor).
  gamingStatus      String?
  /// Faixa / áudio ativo na sala (Spotify etc.).
  mediaHint         String?
  /// Pensamento guardado na hibernação para a 1ª abertura do dia.
  morningThought    String?
  morningThoughtDayKey String?
  /// IANA timezone do usuário (ex.: America/Toronto) — sono/dia local.
  timezone          String?
  /// sunny | rainy | snowy | cloudy | night — Open-Meteo + hora local.
  weatherCondition  String?
  weatherTempC      Int?
  weatherAt         DateTime?
  /// Últimas coords conhecidas (GPS iPhone; fallback Toronto na Edge).
  lat               Float?
  lon               Float?
  /// Flags de easter eggs (sawSnow, midnightOpen, stormChatAt…).
  secretFlags       Json       @default("{}")
  /// Título ativo de convivência (ex.: "Rei do Sofá").
  activeTitle       String?
  titleKey          String?
  indoorMinutes     Int            @default(0)
  workMinutes       Int            @default(0)
  sleepMinutes      Int            @default(0)
  /// Keys de badges já conquistadas (append-only).
  unlockedTitles    String[]       @default([])
  /// Título que o usuário escolheu exibir.
  equippedTitleKey  String?
  contextJson       Json?
  lastContextAt     DateTime?
  pendingAlert      String?
  memoryNotes       String[]       @default([])
  /// Quiz preferences: vibe, archetype, focus, communicationStyle, …
  traits            Json?
  createdAt         DateTime       @default(now())
  interactions      Interaction[]
  thoughts          CompanionThought[]

  @@index([userId])
  @@index([decayFrozen])
  @@index([lifeMode])
}

model CompanionThought {
  id            String    @id
  companionId   String
  companion     Companion @relation(fields: [companionId], references: [id], onDelete: Cascade)
  userId        String
  text          String
  kind          String    @default("mood")
  zoneName      String?
  lifeMode      String?
  mediaHint     String?
  gamingStatus  String?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([companionId, createdAt])
}

model Interaction {
  id             String          @id @default(cuid())
  companionId    String
  companion      Companion       @relation(fields: [companionId], references: [id], onDelete: Cascade)
  type           InteractionType
  userMessage    String?
  reactionText   String
  moodAfter      Mood
  energyAfter    Int
  affectionAfter Int
  createdAt      DateTime        @default(now())

  @@index([companionId, createdAt])
}

model UserMissionProgress {
  id              String      @id @default(cuid())
  userId          String
  dayKey          String
  kind            MissionKind
  title           String
  description     String
  target          Int
  progress        Int         @default(0)
  rewardEnergy    Int         @default(8)
  rewardAffection Int         @default(5)
  claimed         Boolean     @default(false)
  createdAt       DateTime    @default(now())

  @@unique([userId, dayKey, kind])
  @@index([userId, dayKey])
}

/// Daily HealthKit step ledger (cloud-authoritative feed).
model StepsLedger {
  id           String   @id @default(cuid())
  userId       String
  dayKey       String
  steps        Int      @default(0)
  energyGranted Int     @default(0)
  updatedAt    DateTime @default(now())

  @@unique([userId, dayKey])
  @@index([userId])
}
