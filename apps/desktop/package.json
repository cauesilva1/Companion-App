{
  "name": "companion-desktop",
  "version": "1.0.0",
  "description": "Companion virtual — popup Tamagotchi para desktop",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "start": "electron .",
    "watch": "tsc --watch",
    "prepare:bundle": "node ../../scripts/prepare-desktop-bundle.mjs",
    "pack": "npm run prepare:bundle && tsc && electron-builder --mac dir",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run prepare:bundle && tsc && electron-builder --mac dir && node ../../scripts/make-dmg.mjs"
  },
  "build": {
    "appId": "com.companion.tamagotchi",
    "productName": "Companion",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/api",
        "to": "api"
      },
      {
        "from": "resources/.env",
        "to": ".env"
      }
    ],
    "icon": "build/icon.png",
    "electronVersion": "31.7.7",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dir"
      ],
      "identity": null
    },
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "dotenv": "^16.4.0"
  }
}
